<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<!-- Thêm phần này để lưu dữ liệu -->
	<appSettings>
		<add key="Station" value="Station: PPG-01" />
		<add key="PlcIp" value="192.168.1.220" />
		<add key="PlcPort" value="502" />

		<!-- QR Validation: các pattern nhận dạng QR của Phiếu Cắt (Cut Sheet) -->
		<!-- Dùng dấu | để phân cách nhiều pattern. Ví dụ: |### -->
		<add key="CutSheetQR_EndsWith" value="--" />
		<!-- Dùng dấu | để phân cách nhiều pattern. Ví dụ: &quot;-|'- -->
		<add key="CutSheetQR_Contains" value="&quot;-" />

		<!-- Đăng nhập Config — mặc định admin/admin, đổi trong tab Tài khoản -->
		<!-- Config_Password lưu dạng MD5 hash. MD5("admin") = 21232f297a57a5a743894a0e4a801fc3 -->
		<add key="Config_Username" value="admin" />
		<add key="Config_Password" value="f19b8dc2029cf707939e886e4b164681" />

		<!-- Tên trạm máy — dùng trong API log (không có prefix "Station: ") -->
		<add key="StationName" value="PPG-01" />

		<!-- Aldila Cutting Validator API — ghi nhận kết quả scan QR -->
		<add key="AldilaCuttingApi_Url"     value="https://192.168.96.10/aldila-portlet/service/savePrepregCuttingValidator" />
		<!-- Bật/tắt gọi API (true/false) -->
		<add key="AldilaCuttingApi_Enabled" value="true" />

		<!-- ERP Dynamics 365 — Kết nối để log dữ liệu quét QR -->
		<!-- OAuth2 / Azure AD -->
		<add key="ERP_TenantId"     value="" />
		<add key="ERP_ClientId"     value="" />
		<add key="ERP_ClientSecret" value="" />
		<!-- URL tổ chức Dynamics 365, ví dụ: https://yourorg.crm.dynamics.com -->
		<add key="ERP_BaseUrl"      value="https://192.168.96.10" />
		<!-- Endpoint OData API, ví dụ: /api/data/v9.2/cut_sheetlogs -->
		<add key="ERP_Endpoint"     value="/aldila-portlet/service/savePrepregCuttingValidator" />
		<!-- Bật/tắt tính năng log ERP (true/false) -->
		<add key="ERP_Enabled"      value="false" />
	</appSettings>
</configuration>